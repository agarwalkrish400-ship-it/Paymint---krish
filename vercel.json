{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/admin/:route", "destination": "/api/admin/[route]" },
    { "source": "/api/users/:route", "destination": "/api/users/[route]" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
